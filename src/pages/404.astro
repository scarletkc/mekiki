---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import SearchX from '@lucide/astro/icons/search-x';
import { DEFAULT_LOCALE, LOCALES, LOCALE_INFO, localePath, useTranslations } from '../i18n';
import Base from '../layouts/Base.astro';

const t = useTranslations(DEFAULT_LOCALE);
---

<Base locale={DEFAULT_LOCALE} path="/" title={t.notFound.title} noindex>
  <div class="mx-auto max-w-xl py-6 sm:py-12">
    <div class="bg-muted text-muted-foreground mb-8 grid size-12 place-items-center rounded-xl border">
      <SearchX class="size-6" />
    </div>
    <div class="divide-y">
      {
        LOCALES.map((locale) => {
          const text = useTranslations(locale).notFound;
          return (
            <section lang={LOCALE_INFO[locale].tag} class="py-5 first:pt-0">
              <h1 class="text-xl font-semibold tracking-tight">{text.title}</h1>
              <p class="text-muted-foreground mt-1.5">{text.body}</p>
              <a
                href={localePath(locale, '/')}
                class="text-primary mt-3 inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline"
              >
                <ArrowLeft class="size-4" />
                {text.home}
              </a>
            </section>
          );
        })
      }
    </div>
  </div>
</Base>
