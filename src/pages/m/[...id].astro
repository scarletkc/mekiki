---
import { DEFAULT_LOCALE, useTranslations } from '../../i18n';
import Redirect from '../../layouts/Redirect.astro';
import type { ModelRecord } from '../../lib/dataset';
import { modelImagePath, modelShareText } from '../../lib/share';
import { getDataset } from '../../lib/site-data';

// `/m/<provider>/<model>` is the language-neutral link to a model (the JSON
// API's `url` field). It forwards to the page in the visitor's language.
export async function getStaticPaths() {
  const { models } = await getDataset();
  return models.map((model) => ({ params: { id: model.id }, props: { model } }));
}

const model = Astro.props.model as ModelRecord;
const { description, imageAlt } = modelShareText(model, useTranslations(DEFAULT_LOCALE));
---

<Redirect
  path={`/m/${model.id}`}
  title={model.name}
  description={description}
  image={modelImagePath(model.id)}
  imageAlt={imageAlt}
/>
