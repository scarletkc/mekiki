---
import Redirect from '../../layouts/Redirect.astro';
import { getDataset } from '../../lib/site-data';

// `/m/<provider>/<model>` is the language-neutral link to a model (the JSON
// API's `url` field). It forwards to the page in the default locale.
export async function getStaticPaths() {
  const { models } = await getDataset();
  return models.map((model) => ({ params: { id: model.id } }));
}

const { id } = Astro.params;
---

<Redirect path={`/m/${id}`} />
