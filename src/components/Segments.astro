---
import { localePath, type Locale } from '../i18n';
import type { Segment } from '../lib/change-text';

interface Props {
  locale: Locale;
  segments: Segment[];
  linkable: Set<string>;
}

const { locale, segments, linkable } = Astro.props;
---

{
  segments.map((segment) =>
    typeof segment === 'string' ? (
      segment
    ) : linkable.has(segment.id) ? (
      <a href={localePath(locale, `/m/${segment.id}`)} class="text-primary underline">{segment.name}</a>
    ) : (
      <span class="font-medium">{segment.name}</span>
    ),
  )
}
