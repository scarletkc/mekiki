---
import ImageDown from '@lucide/astro/icons/image-down';
import { buttonVariants } from '@/components/ui/button';
import type { Dictionary } from '../i18n';
import { formatScore } from '../lib/format';
import { ChartWatermark } from './charts/shared';

interface Props {
  title: string;
  name: string;
  strings: Dictionary['chart'];
  points: { date: string; score: number | null }[];
  end: string;
  thresholds: { label: string; value: number }[];
  empty: string;
}

const { title, name, strings, points, end, thresholds, empty } = Astro.props;

const DAY = 86_400_000;
const dayNumber = (date: string) => Math.round(Date.parse(`${date}T00:00:00Z`) / DAY);
const start = points[0]?.date ?? end;
const span = Math.max(1, dayNumber(end) - dayNumber(start));
const x = (date: string) => ((dayNumber(date) - dayNumber(start)) / span) * 1000;

const scores = points.map((point) => point.score).filter((score): score is number => score !== null);
let lo = 0;
let hi = 100;
if (scores.length > 0) {
  lo = Math.max(0, Math.floor((Math.min(...scores) - 3) / 5) * 5);
  hi = Math.min(100, Math.ceil((Math.max(...scores) + 3) / 5) * 5);
  while (hi - lo < 10) {
    if (hi < 100) hi += 5;
    else lo -= 5;
  }
}
const y = (score: number) => ((hi - Math.min(Math.max(score, lo), hi)) / (hi - lo)) * 100;

const steps = points.map((point, index) => ({
  ...point,
  x0: x(point.date),
  x1: x(points[index + 1]?.date ?? end),
}));
let path = '';
let drawing = false;
for (const step of steps) {
  if (step.score === null) {
    drawing = false;
    continue;
  }
  const yy = y(step.score).toFixed(2);
  path += drawing ? ` V${yy}` : ` M${step.x0.toFixed(1)} ${yy}`;
  path += ` H${step.x1.toFixed(1)}`;
  drawing = true;
}

const endScore = points.at(-1)?.score ?? null;
const firstScore = points.find((point) => point.score !== null)?.score ?? null;

const visible = thresholds.filter((item) => item.value > lo && item.value < hi);
const ticks = [
  ...visible.map((item) => item.value),
  ...[lo, hi].filter((value) => visible.every((item) => Math.abs(y(item.value) - y(value)) >= 15)),
];

const label =
  firstScore === null || endScore === null
    ? title
    : `${title}: ${formatScore(firstScore)} → ${formatScore(endScore)}, ${start} – ${end}`;
---

<figure class="bg-card min-w-0 rounded-xl border px-4 pt-3 pb-2">
  <figcaption class="text-muted-foreground flex items-start justify-between gap-3 text-xs">
    <span>{title}</span>
    {scores.length > 0 && (
    <span data-export-ignore class="-my-1 shrink-0">
      <button
        type="button"
        data-chart-export
        data-name={name}
        data-label={strings.export}
        data-done={strings.exported}
        data-failed={strings.exportFailed}
        class={buttonVariants({ variant: 'outline', size: 'sm', className: 'text-foreground h-8 sm:h-7' })}
      >
        <ImageDown />
        <span data-chart-export-label>{strings.export}</span>
      </button>
      <span class="sr-only" aria-live="polite"></span>
    </span>
    )}
  </figcaption>
  {scores.length === 0 ? (
  <p class="text-muted-foreground grid h-36 place-items-center text-sm">{empty}</p>
  ) : (
  <div class="mt-2 pr-11 pl-7">
    <div class="relative h-28" role="img" aria-label={label}>
      {
        visible.map((item) => (
          <span
            class="text-muted-foreground pointer-events-none absolute left-1 -translate-y-full text-[0.625rem] leading-tight"
            style={`top: ${y(item.value)}%`}
          >
            {item.label}
          </span>
        ))
      }
      <svg
        viewBox="0 0 1000 100"
        preserveAspectRatio="none"
        class="absolute inset-0 h-full w-full overflow-visible"
        aria-hidden="true"
      >
        <g class="stroke-border" stroke-width="1" vector-effect="non-scaling-stroke">
          {[lo, hi, ...visible.map((item) => item.value)].map((value) => (
            <line x1="0" x2="1000" y1={y(value)} y2={y(value)} vector-effect="non-scaling-stroke"></line>
          ))}
        </g>
        <path
          d={path}
          fill="none"
          class="stroke-quality"
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
        <g fill="transparent">
          {steps.map((step) => (
            <rect x={step.x0} y="0" width={Math.max(step.x1 - step.x0, 8)} height="100">
              <title>{`${step.date}: ${step.score === null ? '–' : formatScore(step.score)}`}</title>
            </rect>
          ))}
        </g>
      </svg>

      {
        ticks.map((value) => (
          <span
            class="text-muted-foreground num absolute right-full mr-1.5 -translate-y-1/2 text-[0.6875rem] leading-none"
            style={`top: ${y(value)}%`}
          >
            {value}
          </span>
        ))
      }
      {
        endScore !== null && (
          <>
            <span
              class="bg-quality ring-card pointer-events-none absolute size-2 -translate-1/2 rounded-full ring-2"
              style={`left: 100%; top: ${y(endScore)}%`}
            ></span>
            <span
              class="num absolute left-full ml-2.5 -translate-y-1/2 text-xs leading-none font-medium"
              style={`top: ${y(endScore)}%`}
            >
              {formatScore(endScore)}
            </span>
          </>
        )
      }
    </div>
    <div class="text-muted-foreground num mt-1 flex justify-between text-[0.6875rem]">
      <span>{start}</span>
      <span>{end}</span>
    </div>
  </div>
  )}
  {scores.length > 0 && (
  <div class="mt-2 flex justify-end">
    <ChartWatermark />
  </div>
  )}
</figure>

<script>
  import { chartImageName, exportChartImage } from '../lib/chart-image';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-chart-export]')) {
    const label = button.querySelector<HTMLElement>('[data-chart-export-label]');
    const status = button.nextElementSibling as HTMLElement | null;
    let timer: number | undefined;

    button.addEventListener('click', async () => {
      const figure = button.closest('figure');
      if (!figure) return;
      window.clearTimeout(timer);
      button.disabled = true;
      let result: string;
      try {
        await exportChartImage(figure, chartImageName([button.dataset.name ?? '']));
        result = button.dataset.done ?? '';
      } catch {
        result = button.dataset.failed ?? '';
      }
      button.disabled = false;
      if (label) label.textContent = result;
      if (status) status.textContent = result;
      timer = window.setTimeout(() => {
        if (label) label.textContent = button.dataset.label ?? '';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>
