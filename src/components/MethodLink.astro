---
import Info from '@lucide/astro/icons/info';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  section?: string;
  small?: boolean;
}

const { locale, section, small = false } = Astro.props;
const t = useTranslations(locale);
const href = `${localePath(locale, '/method')}${section ? `#${section}` : ''}`;
---

<a
  href={href}
  class="text-muted-foreground hover:text-foreground inline-flex shrink-0 transition-colors"
  aria-label={t.usage.about}
  title={t.usage.about}
>
  <Info class={small ? 'size-3.5' : 'size-4'} />
</a>
