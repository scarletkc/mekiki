---
import { useTranslations, type Locale } from '../i18n';
import { describeChange } from '../lib/change-text';
import type { Change } from '../lib/changelog';
import Segments from './Segments.astro';

interface Props {
  locale: Locale;
  change: Change;
  linkable: Set<string>;
}

const { locale, change, linkable } = Astro.props;
const segments = describeChange(change, useTranslations(locale));
---

<Segments locale={locale} segments={segments} linkable={linkable} />
