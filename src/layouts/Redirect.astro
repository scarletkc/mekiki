---
/**
 * A page that only forwards to the same page in one of the locales.
 * Unprefixed URLs (`/`, `/method`, `/m/<provider>/<model>`) are kept as
 * stable, language-neutral links; this is what they serve.
 *
 * The locale is picked in the browser, in this order:
 * 1. the language the visitor last chose in the switcher (stored by
 *    src/layouts/Base.astro under the `locale` key);
 * 2. the first browser language we have: Chinese goes to `zh-tw` for
 *    Traditional script or Taiwan, Hong Kong and Macau, else to `zh-cn`;
 * 3. the default locale.
 *
 * GitHub Pages cannot send HTTP redirects, so the page redirects by script,
 * which keeps the query string and hash. Without JavaScript, a meta refresh
 * goes to the default locale.
 */
import { DEFAULT_LOCALE, LOCALES, LOCALE_INFO, localePath, pagePath } from '../i18n';
import { SITE_URL } from '../lib/dataset';

interface Props {
  /** Page path without a locale prefix, e.g. `/method`. */
  path: string;
}

const path = pagePath(Astro.props.path);
const fallbackTarget = localePath(DEFAULT_LOCALE, path);
const locales = [...LOCALES];
---

<!doctype html>
<html lang={LOCALE_INFO[DEFAULT_LOCALE].tag}>
  <head>
    <meta charset="utf-8" />
    <title>mekiki</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(fallbackTarget, SITE_URL).href} />
    <script is:inline define:vars={{ path, locales, fallback: DEFAULT_LOCALE }}>
      function known(locale) {
        return locales.indexOf(locale) !== -1 ? locale : null;
      }

      // Map a BCP 47 tag such as `zh-Hant-HK` or `en-US` to one of our locales.
      function fromTag(tag) {
        var parts = String(tag || '').toLowerCase().split(/[-_]/);
        if (parts[0] !== 'zh') return known(parts[0]);
        if (parts.indexOf('hant') > 0) return known('zh-tw');
        if (parts.indexOf('hans') > 0) return known('zh-cn');
        var traditional = parts.some(function (part) {
          return part === 'tw' || part === 'hk' || part === 'mo';
        });
        return known(traditional ? 'zh-tw' : 'zh-cn');
      }

      function pick() {
        var stored = null;
        try {
          stored = known(localStorage.getItem('locale'));
        } catch (error) {}
        if (stored) return stored;
        var tags =
          navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];
        var matches = tags.map(fromTag).filter(Boolean);
        return matches[0] || fallback;
      }

      window.location.replace('/' + pick() + path + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${fallbackTarget}`} /></noscript>
  </head>
  <body>
    <p><a href={fallbackTarget}>mekiki</a></p>
  </body>
</html>
