---
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_INFO,
  localePath,
  pagePath,
  useTranslations,
} from '../i18n';
import { SITE_URL } from '../lib/dataset';
import { OG_HEIGHT, OG_WIDTH, SITE_IMAGE_PATH } from '../lib/share';

interface Props {
  path: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const path = pagePath(Astro.props.path);
const fallbackTarget = localePath(DEFAULT_LOCALE, path);
const locales = [...LOCALES];

const t = useTranslations(DEFAULT_LOCALE);
const { title, image = SITE_IMAGE_PATH, imageAlt } = Astro.props;
const pageTitle = title ? `${title} | mekiki` : `mekiki | ${t.meta.tagline}`;
const description = Astro.props.description ?? t.meta.description;
---

<!doctype html>
<html lang={LOCALE_INFO[DEFAULT_LOCALE].tag}>
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(fallbackTarget, SITE_URL).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, SITE_URL).href} />
    <meta property="og:site_name" content="mekiki" />
    <meta property="og:image" content={new URL(image, SITE_URL).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt ?? pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ path, locales, fallback: DEFAULT_LOCALE }}>
      function known(locale) {
        return locales.indexOf(locale) !== -1 ? locale : null;
      }

      function fromTag(tag) {
        var parts = String(tag || '').toLowerCase().split(/[-_]/);
        if (parts[0] !== 'zh') return known(parts[0]);
        if (parts.indexOf('hant') > 0) return known('zh-tw');
        if (parts.indexOf('hans') > 0) return known('zh-cn');
        var traditional = parts.some(function (part) {
          return part === 'tw' || part === 'hk' || part === 'mo';
        });
        return known(traditional ? 'zh-tw' : 'zh-cn');
      }

      function pick() {
        var stored = null;
        try {
          stored = known(localStorage.getItem('locale'));
        } catch (_error) {}
        if (stored) return stored;
        var tags =
          navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];
        var matches = tags.map(fromTag).filter(Boolean);
        return matches[0] || fallback;
      }

      window.location.replace('/' + pick() + path + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${fallbackTarget}`} /></noscript>
  </head>
  <body>
    <p><a href={fallbackTarget}>mekiki</a></p>
  </body>
</html>
