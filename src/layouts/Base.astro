---
import '../styles/global.css';
import instrumentSansLatinUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import BookOpen from '@lucide/astro/icons/book-open';
import Braces from '@lucide/astro/icons/braces';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Globe from '@lucide/astro/icons/globe';
import LayoutList from '@lucide/astro/icons/layout-list';
import Menu from '@lucide/astro/icons/menu';
import MessageSquare from '@lucide/astro/icons/message-square';
import Moon from '@lucide/astro/icons/moon';
import ScrollText from '@lucide/astro/icons/scroll-text';
import Sun from '@lucide/astro/icons/sun';
import X from '@lucide/astro/icons/x';
import GithubMark from '../components/GithubMark.astro';
import Logo from '../components/Logo.astro';
import { buttonVariants } from '../components/ui/button';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_INFO,
  localePath,
  useTranslations,
  type Locale,
} from '../i18n';
import { latestSync, SITE_URL } from '../lib/dataset';
import { feedPath } from '../lib/feed';
import { formatDateTime } from '../lib/format';
import { OG_HEIGHT, OG_WIDTH, SITE_IMAGE_PATH } from '../lib/share';
import { getDataset } from '../lib/site-data';
import { SOURCE_INFO } from '../lib/snapshots';

interface Props {
  locale: Locale;
  path: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { locale, path, title, description, image = SITE_IMAGE_PATH, imageAlt, noindex = false } =
  Astro.props;
const t = useTranslations(locale);
const dataset = await getDataset();
const synced = latestSync(dataset);

const pageTitle = title ? `${title} | mekiki` : `mekiki | ${t.meta.tagline}`;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(localePath(locale, path), SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;

const nav = [
  { href: localePath(locale, '/'), label: t.nav.models, key: '/', icon: LayoutList },
  {
    href: localePath(locale, '/changelog'),
    label: t.nav.changes,
    key: '/changelog',
    icon: ScrollText,
  },
  { href: localePath(locale, '/method'), label: t.nav.method, key: '/method', icon: BookOpen },
  { href: localePath(locale, '/api'), label: t.nav.api, key: '/api', icon: Braces },
];
const languages = LOCALES.map((item) => ({
  locale: item,
  href: localePath(item, path),
  current: item === locale,
  ...LOCALE_INFO[item],
}));
const section = noindex
  ? null
  : path === '/' || path === '/compare' || path.startsWith('/m/')
    ? '/'
    : path;

const headerButton = {
  language: buttonVariants({
    variant: 'ghost',
    className: 'text-muted-foreground group-open:bg-muted group-open:text-foreground',
  }),
  theme: buttonVariants({
    variant: 'ghost',
    size: 'icon-lg',
    className: 'text-muted-foreground md:size-8',
  }),
  github: buttonVariants({
    variant: 'ghost',
    size: 'icon',
    className: 'text-muted-foreground max-md:hidden',
  }),
  menu: buttonVariants({
    variant: 'ghost',
    size: 'icon-lg',
    className: 'group-open:bg-muted -mr-1.5',
  }),
};

const REPO_URL = 'https://github.com/scarletkc/mekiki';
const FEEDBACK_URL = `${REPO_URL}/issues/new/choose`;
const footerLink =
  'decoration-muted-foreground/40 hover:text-foreground hover:decoration-foreground underline underline-offset-4 transition-colors';
const attribution = [
  SOURCE_INFO.aa,
  SOURCE_INFO.arena,
  SOURCE_INFO.livebench,
  SOURCE_INFO.modelsdev,
];
---

<!doctype html>
<html lang={LOCALE_INFO[locale].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={instrumentSansLatinUrl}
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex && LOCALES.map((item) => (
        <link
          rel="alternate"
          hreflang={LOCALE_INFO[item].tag}
          href={new URL(localePath(item, path), SITE_URL).href}
        />
      ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath(DEFAULT_LOCALE, path), SITE_URL).href}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/json" href="/api.json" title="mekiki API" />
    <link rel="alternate" type="application/rss+xml" href={feedPath(locale)} title={t.changelog.feedTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mekiki" />
    <meta property="og:locale" content={LOCALE_INFO[locale].tag.replace('-', '_')} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt ?? pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafbfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (_error) {}
        var dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-background sr-only z-50 rounded-lg border px-3 py-2 shadow-sm focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      {t.nav.skip}
    </a>

    <header class="site-header sticky top-0 z-40 border-b">
      <div class="mx-auto flex h-14 w-full max-w-[1280px] items-center gap-2 px-4 sm:px-6 md:gap-6">
        <a
          href={localePath(locale, '/')}
          class="-ml-1 flex items-center gap-2.5 rounded-lg px-1 py-1"
          aria-label={`mekiki, ${t.meta.tagline}`}
        >
          <Logo class="size-7" />
          <span class="text-[1.0625rem] leading-none font-semibold tracking-tight">mekiki</span>
        </a>

        <nav aria-label={t.nav.main} class="hidden md:block">
          <ul class="flex items-center gap-1 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.key === section ? 'page' : undefined}
                    class="text-muted-foreground hover:text-foreground hover:bg-muted aria-[current=page]:bg-muted aria-[current=page]:text-foreground rounded-lg px-3 py-1.5 transition-colors aria-[current=page]:font-medium"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-1">
          <details class="group relative hidden md:block" data-menu>
            <summary class={headerButton.language}>
              <Globe class="size-4" />
              <span class="sr-only">{t.nav.language}:</span>
              <span>{LOCALE_INFO[locale].name}</span>
              <ChevronDown class="size-3.5 opacity-60 transition-transform group-open:rotate-180" />
            </summary>
            <ul class="menu-panel absolute top-full right-0 mt-2 w-44 p-1" aria-label={t.nav.language}>
              {
                languages.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      hreflang={item.tag}
                      lang={item.tag}
                      aria-current={item.current ? 'true' : undefined}
                      data-locale-link={item.locale}
                      class="text-muted-foreground hover:bg-accent hover:text-foreground aria-[current=true]:text-foreground flex items-center justify-between gap-3 rounded-md px-2.5 py-1.5 text-sm aria-[current=true]:font-medium"
                    >
                      {item.name}
                      {item.current && <Check class="text-primary size-4" />}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>

          <button
            type="button"
            data-theme-toggle
            aria-label={t.theme.toggle}
            title={t.theme.toggle}
            class={headerButton.theme}
          >
            <Sun class="size-[1.125rem] dark:hidden" />
            <Moon class="hidden size-[1.125rem] dark:block" />
          </button>

          <a
            href={REPO_URL}
            aria-label={t.nav.github}
            title={t.nav.github}
            class={headerButton.github}
          >
            <GithubMark class="size-[1.125rem]" />
          </a>

          <details class="group md:hidden" data-menu data-mobile-menu>
            <summary
              aria-label={t.nav.menu}
              title={t.nav.menu}
              class={headerButton.menu}
            >
              <Menu class="size-5 group-open:hidden" />
              <X class="hidden size-5 group-open:block" />
            </summary>
            <div
              class="bg-background absolute inset-x-0 top-full max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-b shadow-lg"
            >
              <nav aria-label={t.nav.main} class="px-2 pt-2 pb-1">
                <ul>
                  {
                    nav.map((item) => {
                      const Icon = item.icon;
                      return (
                        <li>
                          <a
                            href={item.href}
                            aria-current={item.key === section ? 'page' : undefined}
                            class="text-muted-foreground hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground flex items-center gap-3 rounded-lg px-3 py-2.5 text-base aria-[current=page]:font-medium"
                          >
                            <Icon class="size-[1.125rem] opacity-80" />
                            {item.label}
                          </a>
                        </li>
                      );
                    })
                  }
                </ul>
              </nav>
              <div class="border-t px-4 py-3">
                <p class="text-muted-foreground mb-2 flex items-center gap-1.5 text-xs font-medium">
                  <Globe class="size-3.5" />
                  {t.nav.language}
                </p>
                <ul class="bg-muted grid grid-cols-3 gap-1 rounded-lg p-1" aria-label={t.nav.language}>
                  {
                    languages.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          hreflang={item.tag}
                          lang={item.tag}
                          aria-current={item.current ? 'true' : undefined}
                          data-locale-link={item.locale}
                          class="text-muted-foreground aria-[current=true]:bg-background aria-[current=true]:text-foreground block rounded-md px-2 py-2 text-center text-sm aria-[current=true]:font-medium aria-[current=true]:shadow-sm"
                        >
                          {item.name}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="border-t px-2 py-2">
                <a
                  href={REPO_URL}
                  class="text-muted-foreground hover:bg-muted hover:text-foreground flex items-center gap-3 rounded-lg px-3 py-2.5 text-base"
                >
                  <GithubMark class="size-[1.125rem]" />
                  {t.nav.github}
                </a>
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-[1280px] flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>

    <footer class="text-muted-foreground border-t text-xs">
      <div
        class="mx-auto flex w-full max-w-[1280px] flex-col gap-3 px-4 py-6 leading-relaxed sm:px-6 md:flex-row md:items-start md:justify-between md:gap-8"
      >
        <p>
          {t.footer.sources}{
            attribution.map((source, index) => (
              <>
                {index > 0 && t.footer.listSeparator}
                <a class={footerLink} href={source.url}>{source.name}</a>
              </>
            ))
          }{t.footer.fullStop.trimEnd()}
        </p>
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 md:shrink-0 md:justify-end">
          <span class="max-md:basis-full">
            {t.footer.synced}<span class="num">{synced ? formatDateTime(synced) : t.footer.never}</span>
          </span>
          <span aria-hidden="true" class="max-md:hidden">·</span>
          <a
            href={FEEDBACK_URL}
            class="group hover:text-foreground inline-flex items-center gap-1.5 transition-colors"
          >
            <MessageSquare class="size-3.5" />
            <span
              class="decoration-muted-foreground/40 group-hover:decoration-foreground underline underline-offset-4 transition-colors"
              >{t.footer.feedback}</span
            >
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={REPO_URL}
            class="group hover:text-foreground inline-flex items-center gap-1.5 transition-colors"
          >
            <GithubMark class="size-3.5" />
            <span
              class="decoration-muted-foreground/40 group-hover:decoration-foreground underline underline-offset-4 transition-colors"
              >{t.footer.repo}</span
            >
          </a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var toggle = document.querySelector('[data-theme-toggle]');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var dark = !root.classList.contains('dark');
            root.classList.toggle('dark', dark);
            try {
              localStorage.setItem('theme', dark ? 'dark' : 'light');
            } catch (_error) {}
          });
        }
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (event) {
          var stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch (_error) {}
          if (!stored) root.classList.toggle('dark', event.matches);
        });
        document.querySelectorAll('[data-locale-link]').forEach(function (link) {
          link.addEventListener('click', function () {
            link.setAttribute('href', link.pathname + window.location.search + window.location.hash);
            try {
              localStorage.setItem('locale', link.getAttribute('data-locale-link'));
            } catch (_error) {}
          });
        });
        var menus = Array.prototype.slice.call(document.querySelectorAll('details[data-menu]'));
        menus.forEach(function (menu) {
          menu.addEventListener('toggle', function () {
            if (!menu.open) return;
            menus.forEach(function (other) {
              if (other !== menu) other.open = false;
            });
          });
        });
        document.addEventListener('click', function (event) {
          menus.forEach(function (menu) {
            if (menu.open && !menu.contains(event.target)) menu.open = false;
          });
        });
        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          menus.forEach(function (menu) {
            if (!menu.open) return;
            var hadFocus = menu.contains(document.activeElement);
            menu.open = false;
            var summary = menu.querySelector('summary');
            if (summary && hadFocus) summary.focus();
          });
        });
        var mobile = document.querySelector('[data-mobile-menu]');
        window.matchMedia('(min-width: 48rem)').addEventListener('change', function (event) {
          if (event.matches && mobile) mobile.open = false;
        });
      })();
    </script>
  </body>
</html>
