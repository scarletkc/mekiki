---
import { CompareTable, type CompareStrings } from '../components/CompareTable';
import ShareButton from '../components/ShareButton.astro';
import { fmt, localePath, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { defaultCompareIds, toCompareModel } from '../lib/compare';
import { COMPARE_MAX } from '../lib/share';
import { getDataset } from '../lib/site-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { models } = await getDataset();

const ordered = [...models].sort(
  (a, b) => Number(a.status === 'legacy') - Number(b.status === 'legacy'),
);
const rows = ordered.map((model) => toCompareModel(model, localePath(locale, `/m/${model.id}`)));

const strings: CompareStrings = {
  compare: t.compare,
  rating: t.rating,
  tier: t.tier,
  empty: t.empty,
  metric: t.metric,
  badge: t.badge,
  detail: {
    input: t.detail.input,
    output: t.detail.output,
    cacheRead: t.detail.cacheRead,
    blended: t.detail.blended,
    context: t.detail.context,
    tokens: t.detail.tokens,
    releaseDate: t.detail.releaseDate,
    weights: t.detail.weights,
    open: t.detail.open,
    closed: t.detail.closed,
  },
};
---

<Base locale={locale} path="/compare" title={t.compare.title}>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="max-w-[68ch]">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t.compare.title}</h1>
      <p class="text-muted-foreground mt-2 leading-relaxed">
        {fmt(t.compare.intro, { n: COMPARE_MAX })}
      </p>
    </div>
    <ShareButton locale={locale} />
  </div>
  <CompareTable client:load models={rows} initial={defaultCompareIds(models)} strings={strings} />
</Base>
