---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Braces from '@lucide/astro/icons/braces';
import Columns2 from '@lucide/astro/icons/columns-2';
import ExternalLink from '@lucide/astro/icons/external-link';
import ShareButton from '../components/ShareButton.astro';
import ChangeText from '../components/ChangeText.astro';
import Giscus from '../components/Giscus.astro';
import HistoryChart from '../components/HistoryChart.astro';
import { TierMeter } from '../components/TierMeter';
import { badgeVariants } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import { fmt, LOCALE_INFO, localePath, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { changesFor, modelSeries } from '../lib/changelog';
import type { ModelRecord } from '../lib/dataset';
import { compareQuery } from '../lib/compare';
import { formatPercent, formatPrice, formatScore } from '../lib/format';
import { modelDetail } from '../lib/model-detail';
import { scoringConfig } from '../lib/scoring.config';
import { modelImagePath, modelShareText } from '../lib/share';
import { utcDate } from '../lib/history';
import { getDataset, getHistory } from '../lib/site-data';
import { usageDetail, usagePeriod } from '../lib/usage';

interface Props {
  locale: Locale;
  model: ModelRecord;
}

const { locale, model } = Astro.props;
const t = useTranslations(locale);
const dataset = await getDataset();
const { intelligence, cost, value } = model.rating;
const { metrics, links, costNote, groups } = modelDetail(model, t);

const period = usagePeriod(dataset);
const usage = period ? usageDetail(model, period, t) : null;

const badgeClass = badgeVariants({
  variant: 'outline',
  className: 'text-muted-foreground font-normal',
});

const { description, imageAlt } = modelShareText(model, t);
const compareHref = `${localePath(locale, '/compare')}${compareQuery([model.id])}`;
const { entries, changelog } = getHistory();
const today = utcDate(new Date(dataset.generated_at));
const series = modelSeries(entries, model.id, {
  date: today,
  intelligence: intelligence.score,
  value: value.score,
});
const historyStart = series[0]?.date ?? today;
const modelChanges = changesFor(changelog, model.id).slice(0, 12);
const linkable = new Set(dataset.models.map((item) => item.id));
const thresholds = <K extends 'intelligence' | 'value'>(kind: K) => {
  const tiers = scoringConfig[kind].tiers;
  return (['top', 'high', 'mid', 'low'] as const).map((key) => ({
    label: t.tier[kind][key],
    value: tiers[key],
  }));
};
---

<Base
  locale={locale}
  path={`/m/${model.id}`}
  title={model.name}
  description={description}
  image={modelImagePath(model.id)}
  imageAlt={imageAlt}
>
  <a
    href={localePath(locale, '/')}
    class="text-muted-foreground hover:text-foreground -ml-0.5 mb-4 inline-flex items-center gap-1.5 text-sm transition-colors"
  >
    <ArrowLeft class="size-4" />
    {t.detail.back}
  </a>

  <header class="mb-6 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h1 class="text-2xl font-semibold tracking-tight break-words sm:text-3xl">{model.name}</h1>
        {model.status === 'legacy' && <span class={badgeClass}>{t.badge.legacy}</span>}
        {model.facts.open_weights === true && <span class={badgeClass}>{t.badge.openWeights}</span>}
      </div>
      <p class="text-muted-foreground mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
        {model.vendor}
        <span aria-hidden="true">·</span>
        <code class="bg-muted rounded-md px-1.5 py-0.5 font-mono text-[0.8125rem] break-all">{model.id}</code>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a
        href={compareHref}
        class={buttonVariants({ variant: 'outline', size: 'sm', className: 'h-9 sm:h-8' })}
      >
        <Columns2 />
        {t.compare.action}
      </a>
      <ShareButton locale={locale} />
    </div>
  </header>

  <dl class="mb-10 grid gap-3 sm:grid-cols-3">
    <div class="bg-card rounded-xl border px-4 py-3.5">
      <dt class="text-muted-foreground text-xs">{t.rating.intelligence}</dt>
      <dd class="mt-1.5 text-base">
        <TierMeter
          kind="intelligence"
          tier={intelligence.tier}
          label={intelligence.tier ? t.tier.intelligence[intelligence.tier] : t.empty.unrated}
          figure={intelligence.score === null ? null : formatScore(intelligence.score)}
        />
      </dd>
    </div>
    <div class="bg-card rounded-xl border px-4 py-3.5">
      <dt class="text-muted-foreground text-xs">{t.rating.cost}</dt>
      <dd class="mt-1.5 text-base">
        <TierMeter
          kind="cost"
          tier={cost.tier}
          label={cost.tier ? t.tier.cost[cost.tier] : t.empty.noPrice}
          figure={cost.free ? t.empty.free : cost.blended === null ? null : formatPrice(cost.blended)}
        />
      </dd>
      {costNote && <dd class="text-muted-foreground mt-1 text-xs">{costNote}</dd>}
    </div>
    <div class="bg-card rounded-xl border px-4 py-3.5">
      <dt class="text-muted-foreground text-xs">{t.rating.value}</dt>
      <dd class="mt-1.5 text-base">
        <TierMeter
          kind="value"
          tier={value.tier}
          label={value.tier ? t.tier.value[value.tier] : t.empty.unrated}
          figure={value.score === null ? null : formatScore(value.score)}
        />
      </dd>
    </div>
  </dl>

  <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0">
      <section aria-labelledby="breakdown">
        <h2 id="breakdown" class="mb-3 text-lg font-semibold tracking-tight">{t.detail.breakdown}</h2>
        <div class="table-wrap my-0">
          <table class="data-table">
            <caption>{t.detail.breakdown}</caption>
            <thead>
              <tr>
                <th scope="col">{t.detail.metricCol}</th>
                <th scope="col" class="num">{t.detail.raw}</th>
                <th scope="col" class="num">{t.detail.frontier}</th>
                <th scope="col" class="num">{t.detail.normalized}</th>
                <th scope="col" class="num">{t.detail.weight}</th>
              </tr>
            </thead>
            <tbody>
              {
                metrics.map((metric) => (
                  <tr>
                    <th scope="row">
                      {metric.label}
                      {metric.mapped && (
                        <span class="text-muted-foreground block text-xs font-normal">{metric.mapped}</span>
                      )}
                    </th>
                    {metric.raw === null ? (
                      <td class="num text-muted-foreground" colspan="1">{metric.missing}</td>
                    ) : (
                      <td class="num">{metric.raw}</td>
                    )}
                    <td class="num">
                      {metric.frontier === null ? <span class="text-muted-foreground">{t.empty.noData}</span> : metric.frontier}
                    </td>
                    <td class="num">
                      {metric.normalized === null ? <span class="text-muted-foreground">{t.empty.noData}</span> : formatScore(metric.normalized)}
                    </td>
                    <td class="num">{formatPercent(metric.weight)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="history" class="mt-10">
        <h2 id="history" class="mb-3 text-lg font-semibold tracking-tight">{t.detail.history}</h2>
        {
          series.length < 2 ? (
            <p class="text-muted-foreground max-w-[68ch] text-sm">{fmt(t.detail.historyStart, { date: historyStart })}</p>
          ) : (
            <>
              <div class="grid gap-3 sm:grid-cols-2">
                <HistoryChart
                  title={t.rating.intelligence}
                  name={`${model.id} intelligence`}
                  strings={t.chart}
                  points={series.map((point) => ({ date: point.date, score: point.intelligence }))}
                  end={today}
                  thresholds={thresholds('intelligence')}
                  empty={t.empty.unrated}
                />
                <HistoryChart
                  title={t.rating.value}
                  name={`${model.id} value`}
                  strings={t.chart}
                  points={series.map((point) => ({ date: point.date, score: point.value }))}
                  end={today}
                  thresholds={thresholds('value')}
                  empty={t.empty.unrated}
                />
              </div>
              <details class="mt-3 text-sm">
                <summary class="text-muted-foreground hover:text-foreground cursor-pointer text-xs">{t.detail.historyData}</summary>
                <div class="table-wrap mt-2 mb-0">
                  <table class="data-table">
                    <caption>{t.detail.historyData}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{t.detail.date}</th>
                        <th scope="col" class="num">{t.rating.intelligence}</th>
                        <th scope="col" class="num">{t.rating.value}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {[...series].reverse().map((point) => (
                        <tr>
                          <th scope="row" class="num text-start font-normal">{point.date}</th>
                          <td class="num">{point.intelligence === null ? <span class="text-muted-foreground">{t.empty.unrated}</span> : formatScore(point.intelligence)}</td>
                          <td class="num">{point.value === null ? <span class="text-muted-foreground">{t.empty.unrated}</span> : formatScore(point.value)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            </>
          )
        }

        <h3 class="mt-8 mb-2 text-base font-semibold">{t.detail.changes}</h3>
        {
          modelChanges.length === 0 ? (
            <p class="text-muted-foreground text-sm">{fmt(t.detail.noChanges, { date: changelog.start ?? historyStart })}</p>
          ) : (
            <ul class="space-y-1 text-sm">
              {modelChanges.map(({ date, change }) => (
                <li class="flex gap-3">
                  <time datetime={date} class="num text-muted-foreground shrink-0">{date}</time>
                  <span class="min-w-0"><ChangeText locale={locale} change={change} linkable={linkable} /></span>
                </li>
              ))}
            </ul>
          )
        }
        <p class="mt-3 text-sm">
          <a
            href={localePath(locale, '/changelog')}
            class="text-primary inline-flex items-center gap-1.5 underline-offset-4 hover:underline"
          >
            {t.detail.allChanges}
            <ArrowRight class="size-4" />
          </a>
        </p>
      </section>

      <Giscus
        term={model.id}
        lang={LOCALE_INFO[locale].tag}
        heading={t.detail.discussion}
      />
    </div>

    <aside class="min-w-0 text-sm">
      {
        groups.map((group, index) => (
          <section aria-labelledby={group.key} class={index > 0 ? 'mt-8' : undefined}>
            <h2 id={group.key} class="mb-3 text-lg font-semibold tracking-tight">
              {group.title}
            </h2>
            <dl class="bg-card grid grid-cols-[auto_1fr] rounded-xl border px-4 py-1 [&>dd]:border-b [&>dd]:py-2 [&>dd]:text-end [&>dt]:border-b [&>dt]:py-2 [&>dt]:pr-4 [&>dt]:text-muted-foreground [&>:nth-last-child(-n+2)]:border-b-0">
              {group.facts.map((fact) => (
                <>
                  <dt>{fact.label}</dt>
                  <dd class={fact.numeric ? 'num' : undefined}>
                    {fact.value === null ? (
                      <span class="text-muted-foreground">{fact.empty}</span>
                    ) : fact.key === 'modalities' && model.facts.modalities ? (
                      <>
                        <span class="text-muted-foreground">{t.detail.modalityIn}</span> {model.facts.modalities.input.join(', ') || t.empty.noData}
                        <br />
                        <span class="text-muted-foreground">{t.detail.modalityOut}</span> {model.facts.modalities.output.join(', ') || t.empty.noData}
                      </>
                    ) : (
                      fact.value
                    )}
                  </dd>
                </>
              ))}
            </dl>
            {group.notes.length > 0 && (
              <div class="text-muted-foreground mt-3 space-y-1.5 text-xs leading-relaxed">
                {group.notes.map((note) => <p>{note}</p>)}
              </div>
            )}
          </section>
        ))
      }

      {
        usage && (
          <section aria-labelledby="usage">
            <h2 id="usage" class="mt-8 mb-3 text-lg font-semibold tracking-tight">
              {t.usage.title}
            </h2>
            {usage.notFound ? (
              <p class="text-muted-foreground">{usage.notFound}</p>
            ) : (
              <dl class="bg-card grid grid-cols-[auto_1fr] rounded-xl border px-4 py-1 [&>dd]:border-b [&>dd]:py-2 [&>dd]:text-end [&>dt]:border-b [&>dt]:py-2 [&>dt]:pr-4 [&>dt]:text-muted-foreground [&>:nth-last-child(-n+2)]:border-b-0">
                {usage.rows.map((row) => (
                  <>
                    <dt>{row.label}</dt>
                    <dd class={row.muted ? 'text-muted-foreground' : 'num'}>{row.value}</dd>
                  </>
                ))}
              </dl>
            )}
          </section>
        )
      }

      <h2 class="mt-8 mb-3 text-lg font-semibold tracking-tight">{t.detail.links}</h2>
      <ul class="space-y-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-primary inline-flex items-center gap-2 underline-offset-4 hover:underline"
              >
                {link.json ? <Braces class="size-4 shrink-0" /> : <ExternalLink class="size-4 shrink-0" />}
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>
