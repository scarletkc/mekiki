---
import type { TrendData } from '../components/charts/TrendChart';
import { ModelTable, type ModelRow } from '../components/ModelTable';
import { LOCALE_INFO, localePath, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { trendSeries } from '../lib/charts';
import { utcDate } from '../lib/history';
import { getDataset, getHistory } from '../lib/site-data';
import { usageCell, usagePeriod } from '../lib/usage';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dataset = await getDataset();
const period = usagePeriod(dataset);
const usageAvailable =
  period !== null && dataset.models.some((model) => model.openrouter?.rank != null);

const rows: ModelRow[] = dataset.models.map((model) => ({
  id: model.id,
  name: model.name,
  vendor: model.vendor,
  legacy: model.status === 'legacy',
  href: localePath(locale, `/m/${model.id}`),
  intelligence: {
    score: model.rating.intelligence.score,
    tier: model.rating.intelligence.tier,
  },
  cost: {
    tier: model.rating.cost.tier,
    blended: model.rating.cost.blended,
    input: model.rating.cost.input,
    output: model.rating.cost.output,
    free: model.rating.cost.free,
  },
  value: {
    score: model.rating.value.score,
    tier: model.rating.value.tier,
    measuredPrice:
      model.rating.value.cost_basis === 'run_cost' ? model.rating.value.effective_price : null,
  },
  openWeights: model.facts.open_weights,
  usage: usageCell(model, period, t),
}));

const { entries } = getHistory();
const today = utcDate(new Date(dataset.generated_at));
const recorded = entries.filter((entry) => entry.date < today);
const trend: TrendData = {
  start: recorded[0]?.date ?? today,
  end: today,
  days: recorded.length + 1,
  series: Object.fromEntries(
    dataset.models.map((model) => [
      model.id,
      trendSeries(entries, model.id, {
        date: today,
        int: model.rating.intelligence.score,
        val: model.rating.value.score,
        cost: model.rating.cost.blended,
      }),
    ]),
  ),
};

const strings = {
  table: t.table,
  chart: t.chart,
  rating: t.rating,
  tier: t.tier,
  empty: t.empty,
  badge: t.badge,
  usage: t.usage,
  compare: {
    select: t.compare.select,
    selected: t.compare.selected,
    action: t.compare.action,
    clear: t.compare.clear,
    limit: t.compare.limit,
  },
};
---

<Base locale={locale} path="/">
  <div class="mb-6 max-w-[68ch]">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t.home.title}</h1>
    <p class="text-muted-foreground mt-2 leading-relaxed">{t.home.intro}</p>
  </div>
  <ModelTable
    client:load
    models={rows}
    strings={strings}
    lang={LOCALE_INFO[locale].tag}
    compareHref={localePath(locale, '/compare')}
    trend={trend}
    usageAvailable={usageAvailable}
  />
</Base>
