---
import { fmt, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { API_VERSION, apiDoc, toApiModel } from '../lib/api';
import { SITE_URL } from '../lib/dataset';
import { getDataset } from '../lib/site-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const a = t.api;
const { sample, samplePath, endpoints, fields, badges } = apiDoc(await getDataset(), t);
---

<Base locale={locale} path="/api" title={a.title}>
  <article class="prose">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{a.title}</h1>
    <p>{a.intro}</p>

    <h2 id="endpoints">{a.endpointsTitle}</h2>
    <div class="table-wrap">
      <table class="data-table">
        <caption>{a.endpointsCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{a.path}</th>
            <th scope="col">{a.content}</th>
          </tr>
        </thead>
        <tbody>
          {
            endpoints.map((endpoint) => (
              <tr>
                <th scope="row" class="[overflow-wrap:anywhere] sm:whitespace-nowrap">
                  {endpoint.href ? (
                    <a href={endpoint.href}>
                      <code>{endpoint.path}</code>
                    </a>
                  ) : (
                    <code>{endpoint.path}</code>
                  )}
                </th>
                <td class="min-w-[9rem]">{endpoint.content}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="example">{a.exampleTitle}</h2>
    <pre><code>curl {SITE_URL}{samplePath}</code></pre>
    {
      sample && (
        <>
          <p>{fmt(a.exampleBody, { id: sample.id })}</p>
          <pre><code>{JSON.stringify(toApiModel(sample), null, 2)}</code></pre>
        </>
      )
    }

    <h2 id="fields">{a.fieldsTitle}</h2>
    <ul>
      {fields.map((field) => <li>{field}</li>)}
    </ul>

    {
      badges.length > 0 && (
        <>
          <h2 id="badges">{a.badgesTitle}</h2>
          <p>{a.badgesBody}</p>
          <p class="flex flex-wrap gap-1.5">
            {badges.map((badge) => <img src={badge.src} alt={badge.alt} height="20" />)}
          </p>
          <pre><code>{badges.map((badge) => badge.markdown).join('\n')}</code></pre>
        </>
      )
    }

    <h2 id="versioning">{a.versionTitle}</h2>
    <p>{fmt(a.versionBody, { version: API_VERSION })}</p>

    <h2 id="attribution">{a.attributionTitle}</h2>
    <p>{a.attributionBody}</p>
  </article>
</Base>
