---
import { useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { formatDateTime } from '../lib/format';
import { methodContent } from '../lib/method';
import { SOURCE_INFO } from '../lib/snapshots';
import { getDataset } from '../lib/site-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const m = t.method;
const {
  intelligenceBody,
  metrics,
  livebenchNote,
  tierRows,
  formulas,
  costBody,
  costIndexBody,
  valueRunCostBody,
  valueBody,
  tiersCharts,
  changesBody,
  usage,
  sources,
} = methodContent(await getDataset(), locale);
---

<Base locale={locale} path="/method" title={m.title}>
  <article class="prose">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{m.title}</h1>
    <p>{m.intro}</p>

    <h2 id="models">{m.modelsTitle}</h2>
    <p>{m.modelsBody}</p>
    <p>{m.legacyBody}</p>

    <h2 id="intelligence">{m.intelligenceTitle}</h2>
    <p>{intelligenceBody}</p>
    <pre><code>{formulas.normalize}</code></pre>
    <p>{m.benchmarkBody}</p>
    <div class="table-wrap">
      <table class="data-table">
        <caption>{m.weightsCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{t.detail.metricCol}</th>
            <th scope="col">{m.source}</th>
            <th scope="col">{m.floor}</th>
            <th scope="col" class="num">{t.detail.weight}</th>
          </tr>
        </thead>
        <tbody>
          {
            metrics.map((metric) => (
              <tr>
                <th scope="row">{metric.label}</th>
                <td>{metric.source}</td>
                <td>{metric.floor}</td>
                <td class="num">{metric.weight}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>{livebenchNote}</p>

    <h2 id="cost">{m.costTitle}</h2>
    <p>{costBody}</p>
    <p>{costIndexBody}</p>
    <pre><code>{formulas.costIndex}</code></pre>

    <h2 id="value">{m.valueTitle}</h2>
    <p>{valueRunCostBody}</p>
    <pre><code>{formulas.effectivePrice}</code></pre>
    <p>{valueBody}</p>
    <pre><code>{formulas.value}</code></pre>

    <h2 id="tiers">{m.tiersTitle}</h2>
    <div class="table-wrap">
      <table class="data-table">
        <caption>{m.tiersCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{m.tierRating}</th>
            <th scope="col" colspan="5">{m.tierConditions}</th>
          </tr>
        </thead>
        <tbody>
          {
            tierRows.map((row) => (
              <tr>
                <th scope="row">{row.rating}</th>
                {row.tiers.map((tier) => (
                  <td>
                    <code>{tier.key}</code> {tier.label}
                    <span class="num text-muted-foreground block">{tier.rule}</span>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>{tiersCharts}</p>

    <h2 id="changes">{m.changesTitle}</h2>
    <p>{changesBody}</p>

    <h2 id="usage">{m.usageTitle}</h2>
    <p>{usage.body}</p>
    {usage.citation && <p><a href={SOURCE_INFO.openrouter.url}>{usage.citation}</a></p>}

    <h2 id="sources">{m.sourcesTitle}</h2>
    <p>{m.sourcesBody}</p>
    <div class="table-wrap">
      <table class="data-table">
        <caption>{m.sourcesCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{m.sourceName}</th>
            <th scope="col">{m.sourceUse}</th>
            <th scope="col">{m.sourceLicense}</th>
            <th scope="col">{m.sourceUpdated}</th>
          </tr>
        </thead>
        <tbody>
          {
            sources.map((source) => (
              <tr>
                <th scope="row">
                  <a href={source.url}>{source.name}</a>
                  {source.edition && <span class="text-muted-foreground block text-xs font-normal">{source.edition}</span>}
                </th>
                <td>{source.use}</td>
                <td>{source.licenseText}</td>
                <td class="whitespace-nowrap tabular-nums">
                  {source.fetched_at ? formatDateTime(source.fetched_at) : <span class="text-muted-foreground">{t.empty.noData}</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="caveats">{m.caveatsTitle}</h2>
    <ul>
      <li>{m.caveatAaCoding}</li>
      <li>{m.caveatVariants}</li>
      <li>{m.caveatRunCost}</li>
    </ul>
  </article>
</Base>
