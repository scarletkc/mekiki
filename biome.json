{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!data/snapshots",
      "!data/history.jsonl",
      "!public",
      "!src/components/ui"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": { "indentWidth": 4, "quoteStyle": "single" }
  },
  "yaml": { "formatter": { "quoteStyle": "single" } },
  "html": { "experimentalFullSupportEnabled": true },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": { "noImportantStyles": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro", "**/*.ts"],
      "linter": { "rules": { "correctness": { "useHookAtTopLevel": "off" } } }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "complexity": { "useArrowFunction": "off", "useOptionalChain": "off" },
          "style": { "useTemplate": "off" }
        }
      }
    },
    {
      "includes": ["src/i18n/**"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    }
  ]
}
